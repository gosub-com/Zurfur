// ### Convert concrete types to interface

interface Printable
    fun .toStr(self) Str
    
interface Printable2
    fun .toStr(self) Str
    
type MyCollection<T>
    [implicit] fun get .asIterator(self) MyCollectionIter<T>
        nop

type MyCollectionIter<T> {}

type MyCollectionNot<T> {}

type MyCollectionNotIter<T> {}


fun .next<T>(self MyCollectionIter<T>) ?T
    nop

fun .reduceInt(self Iterable<Int>, f fun(item1 Int, item2 Int) Int) ?Int
    return self.asIterator.reduce(f) 

fun test_takePrintable(a Printable)
    @x = a.toStr
    x = ""
    
fun test_printable()
    test_takePrintable(1)
    test_takePrintable(1.0)
    test_takePrintable("")
    test_takePrintable(MyCollection<Int>()) // *** Doesn't implement Printable
    

