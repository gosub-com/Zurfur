// ### Test constraints

// Declare a method to multiply and add three keys on Map<K,V>.
// Return Nan (or MinValue for integer types) if any key is missing.
fun .madd<K,V>(self Map<K,V>, mul1 K, mul2 K, add K) V
where V Number<V>
    if self[mul1]@mul1Val and self[mul2]@mul2Val and self[add]@addVal
        return mul1Val * mul2Val + addVal
    return V.NanOrMin        

fun useMadd1(map Map<Str,Int>, b Int)
    map.madd("", "", "")

fun useMadd2<K,V>(map Map<K,V>, b K)
where V Number<V>
    map.madd(K(), K(), K())

fun useMadd3<K,V>(map Map<K,V>, b K)
    map.madd(K(), K(), K()) // *** TEST CASE FAIL *** K should be constrained!!!


fun useMadd4(map Map<Str,Int>, b Int)
    map.madd("", "", 1)  // *** Constraint doesn't allow


