
// Basic shapes for use with 2d drawing library.
// Point, Size, Rect.
// TBD: Vec2, Vec3, Vec4 for 3d, is Point same as Vec2?
mod Zurfur.Draw2d

use Zurfur[Number]

fun test_Shape()
    @rect = Rect(1,2,3,4)
    
    rect.location.y = 30
    @p1 = rect.location
    @rly1 = rect.location.y
    @rly2 = rect.location.x2
    @p2 = p1 + Point(1,2)
    @p3 = 2*p1
    @p4 = p1*2


[pub]
type struct Point<T> where T Number<T> { x T; y T }

[pub]
type struct Size<T> where T Number<T> { width T; height T }

[pub]
type struct Rect<T> where T Number<T> { location Point<T>; size Size<T> }

// Identical to a field
fun get .x2<T>(self Point<T>) mut &T
    return &self.x // TBD: Require `&`, do not allow just `self.x`

// Identical to fields (not necessary when we have 'use location Point<T>' syntax)
[pub]
fun get .x<T>(self Rect<T>) mut &T
    return &self.location.x // TBD: Require `&`
    
[pub]
fun get .y<T>(self Rect<T>) mut &T
    return &self.location.y // TBD: Require `&`
    
[pub]
fun get .width<T>(self Rect<T>) mut &T
    return &self.size.height // TBD: Require `&`
    
[pub]
fun get .height<T>(self Rect<T>) mut &T
    return &self.size.width // TBD: Require `&`
    


[pub]
fun .new<T>(self Point<T>, x T, y T)
    // TBD: (self.x, self.y) = (x, y)
    self.x = x
    self.y = y


[pub]
fun .toSize<T>(self Point<T>) Size<T>
    return Size<T>(self.x, self.y)

// TBD: Remove
fun .yf<T>(self Point<T>) T
    return self.y


[pub]
fun _opAdd<T>(a Point<T>, b Point<T>) Point<T>
where T Number<T>
    return Point(a.x+b.x, a.y+b.y)

[pub]
fun _opNeg<T>(a Point<T>) Point<T>
where T Number<T>
    return Point(-a.x, -a.y)

[pub]
fun _opSub<T>(a Point<T>, b Point<T>) Point<T>
where T Number<T>
    return Point(a.x-b.x, a.y-b.y)

[pub]
fun _opMul<T>(a T, b Point<T>) Point<T>
where T Number<T>
    return Point(a*b.x, a*b.y)

[pub]
fun _opMul<T>(a Point<T>, b T) Point<T>
where T Number<T>
    return Point(a.x*b, a.y*b)

[pub]
fun _opDiv<T>(a T, b Point<T>) Point<T>
where T Number<T>
    return Point(a/b.x, a/b.y)

[pub]
fun _opDiv<T>(a Point<T>, b T) Point<T>
where T Number<T>
    return Point(a.x/b, a.y/b)

[pub]
fun .new<T>(self Size<T>, width T, height T)
    // TBD: (self.width, self.height) = (width, height)
    self.width = width
    self.height = height
    
[pub]
fun .toPoint<T>(self Size<T>) Point<T>
    return Point(self.width, self.height)



[pub]
fun .new<T>(self Rect<T>, x T, y T, width T, height T)
    self.x = x
    self.y = y
    self.width = width
    self.height = height
    
[pub]
fun .new<T>(self Rect<T>, location Point<T>, size Size<T>)
    self.location = location
    self.size = size


// TBD: Operators (add, multiply, divide, sizes, etc.)

[pub]
fun get .left<T>(self Rect<T>) T
    return self.x
    
[pub]
fun get .right<T>(self Rect<T>) T // TBD: Use constraints from `Rect`
where T Number<T>
    return self.x + self.width

[pub]
fun get .top<T>(self Rect<T>) T
    return self.y
    
[pub]
fun get .bottom<T>(self Rect<T>) T // TBD: Use constraints from `Rect`
where T Number<T>
    return self.y + self.height
    
    
