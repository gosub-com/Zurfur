
mod Zurfur

[pub]
interface Iterable<T>
    fun .asIterator(self) Iterator<T>

// Implement this on all iterators
[pub]
interface Iterator<T>
    fun mut .next(self) ?T


// This is never called.  It is implemented by the compiler to generate a for loop.
fun ._for<T>(self Iterator<T>) T extern


// *** MAP ***

fun .map<S, R>(self Iterator<S>, f fun(input S) R) Iterator<R>
    return MapIterator<S, R>(self, f)
    
type ref MapIterator<S, R>
    _iter Iterator<S>
    _f fun(input S) R

// TBD: Remove this when `init` is implemented
fun .new<S, R>(self MapIterator<S,R>, iter Iterator<S>, f fun(input S) R)
    self._iter = iter
    self._f = f

fun .next<S, R>(self mut MapIterator<S,R>) ?R
    let a = self._iter.next()
    if a @ item
        return self._f(a)
    return nil

// *** FILTER ***

fun .filter<S>(self Iterator<S>, f fun(input S) Bool) Iterator<S>
    return FilterIterator<S>(self, f)
    
type ref FilterIterator<S>
    _iter Iterator<S>
    _f fun(input S) Bool

// TBD: Remove this when `init` is implemented
fun .new<S>(self FilterIterator<S>, iter Iterator<S>, f fun(input S) Bool)
    self._iter = iter
    self._f = f

fun .next<S>(self mut FilterIterator<S>) ?S
    while self._iter.next @ item
        if self._f(item)
            return item
    return nil

// *** OTHER ***


fun .reduce<S,R>(self Iterator<S>, acc R, f fun(acc R, value S) R) R
    while self.next() @ item
        acc = f(acc, item)
    return acc

fun .reduce<S>(self Iterator<S>, f fun(item1 S, item2 S) S) ?S
    if not (self.next()@acc)
        return nil
    while self.next() @ item
        acc = f(acc, item)
    return acc


[pub]
fun .toList<T>(self mut Iterator<T>) List<T>
where T Iterable<T>
    @list = List<T>()
    while self.next()@item
        list.push(item)
    return list
    
    
    