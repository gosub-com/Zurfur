

mod Zurfur

use Zurfur[Equatable]
use Zurfur.Unsafe[RawPointer, Ref]

[pub]
type ref Span<T>
    data ro mut &T
    len ro Int

    [pub, implicit] fun get .asIterator(self) SpanIterator<T> todo

    
[pub]
type ref SpanIterator<T>
    _data *T
    _end *T

[pub]
type ref SpanReader
    data mut SpanIterator<Byte>

// Create a span (on the stack if it can, heap if not)
[pub] fun .new<T>(self Span<T>, length Int) todo

[pub]
fun get .asReader(self Span<Byte>) SpanReader todo

afun .read(self SpanReader, data mut Span<Byte>) !Int todo

[pub]
fun .next<T>(self SpanIterator<T>) ?&T
    if self._data >= self._end
        return nil
    @r = self._data
    self._data = self._data + 1
    return Ref(r) // TBD: Unsafe.Ref(r) should work here
       
    
