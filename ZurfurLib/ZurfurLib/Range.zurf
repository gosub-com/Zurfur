
mod Zurfur

use Zurfur[Copy, Iterator, Number]

// TBD: Default constructor taking low and high
[pub]
type struct Range<T>
where T Number<T>
    low T
    high T

    [pub, implicit]
    fun get .asIterator(self) RangeIterator<T>
        return RangeIterator<T>(self.low, self.high)


[pub]
fun .new<T>(self Range<T>, low T, high T)
    // TBD: (r.low, r.high) = (low, high)
    self.low = low
    self.high = high

[pub]
fun get .length<T>(self Range<T>) T // TBD: Use constraints from `Range`
where T Number<T>
    return self.high-self.low
        
[pub]
type RangeIterator<T>
where T Number<T>
    current T pub init
    high T pub init

[pub]
fun .new<T>(self RangeIterator<T>, low T, high T)
    // TBD: (self.current, self.high) = (low, high)
    self.current = low
    self.high = high

[pub]
fun .next<T>(self mut RangeIterator<T>) ?T
where T Number<T>
    if self.current >= self.high
        return nil
    @prev = self.current
    self.current += T.One
    return Maybe<T>(prev)
        