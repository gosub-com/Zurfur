[pub] fun .log10(self F32) F32 extern
[pub] fun .log(self F32, base F32) F32 extern
[pub] fun max(n1 F32, n2 F32) F32 extern
[pub] fun min(n1 F32, n2 F32) F32 extern
[pub] fun .pow(self F32, y F32) F32 extern
[pub] fun .round(self F32, digits Int = 0) F32 extern
